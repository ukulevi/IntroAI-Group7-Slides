% Wizard's Chess Dark HUD Theme for LaTeX Beamer (XeLaTeX)
% Built for Group 7 · CC01 · HCMUT (CO3061 Intro AI)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hud_theme}[2026/11/21 Wizard's Chess Dark HUD Beamer Theme]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{positioning,calc,arrows.meta}
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{anyfontsize}

% ----------------------------------------------------------------------
% 1. Unified Dark HUD Color Palette
% ----------------------------------------------------------------------
\definecolor{HudBg}{HTML}{0F0C14}
\definecolor{HudBgDeep}{HTML}{0A080E}
\definecolor{HudPanel}{HTML}{1A1623}
\definecolor{HudPanelAlt}{HTML}{211B2E}
\definecolor{HudTrack}{HTML}{262035}
\definecolor{HudBorder}{HTML}{7B55B7}
\definecolor{HudLavender}{HTML}{D2BCFF}
\definecolor{HudGold}{HTML}{E3C77F}
\definecolor{HudTeal}{HTML}{5EEAD4}
\definecolor{HudCrimson}{HTML}{E06C75}
\definecolor{HudIvory}{HTML}{F2EDE5}
\definecolor{HudMuted}{HTML}{A9A3B0}
\definecolor{HudStone}{HTML}{6B6378}
\arrayrulecolor{HudBorder!50}

% ----------------------------------------------------------------------
% 2. Typography (XeLaTeX fontspec with resilient fallbacks & TeX ligatures)
% ----------------------------------------------------------------------
\IfFontExistsTF{Cinzel}{
  \newfontfamily\huddisplay{Cinzel}[Scale=MatchUppercase,Ligatures=TeX]
}{
  \newfontfamily\huddisplay{TeX Gyre Pagella}[Ligatures=TeX]
}

\IfFontExistsTF{Inter}{
  \setsansfont{Inter}[Scale=MatchLowercase,Ligatures=TeX]
  \setmainfont{Inter}[Scale=MatchLowercase,Ligatures=TeX]
}{
  \setsansfont{TeX Gyre Heros}[Ligatures=TeX]
  \setmainfont{TeX Gyre Heros}[Ligatures=TeX]
}

\IfFontExistsTF{JetBrains Mono}{
  \setmonofont{JetBrains Mono}[Scale=0.84]
}{
  \setmonofont{Fira Mono}[Scale=0.84]
}

% ----------------------------------------------------------------------
% 3. Beamer Base Geometry & Chrome
% ----------------------------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{footline}{}
\setbeamersize{text margin left=0.85cm, text margin right=0.85cm}

\setbeamercolor{background canvas}{bg=HudBg}
\setbeamercolor{normal text}{fg=HudIvory,bg=HudBg}
\setbeamercolor{structure}{fg=HudLavender}
\setbeamercolor{frametitle}{fg=HudIvory}
\setbeamercolor{framesubtitle}{fg=HudMuted}
\setbeamercolor{itemize item}{fg=HudLavender}
\setbeamercolor{itemize subitem}{fg=HudGold}
\setbeamertemplate{itemize item}{\raisebox{0.18ex}{\tikz\fill[HudLavender] (0,0) -- (0.08,0.08) -- (0.16,0) -- (0.08,-0.08) -- cycle;}}
\setbeamertemplate{itemize subitem}{\textcolor{HudGold}{\scriptsize$\triangleright$}}

% ----------------------------------------------------------------------
% 4. Section State, Grid Toggle, Appendix Counter & Status Tag
% ----------------------------------------------------------------------
\def\hud@section{1}
\def\hud@eyebrow{01 / THE PROBLEM}
\newif\ifhudgrid
\hudgridfalse
\newif\ifhudappendix
\hudappendixfalse
\def\hud@appoffset{12}

\newcommand{\hudsetsection}[2]{%
  \gdef\hud@section{#1}%
  \gdef\hud@eyebrow{#2}%
}
\newcommand{\hudgridon}{\global\hudgridtrue}
\newcommand{\hudgridoff}{\global\hudgridfalse}
\newcommand{\hudstartappendix}{%
  \appendix
  \global\hudappendixtrue
  \xdef\hud@appoffset{\the\value{framenumber}}%
  \hudgridoff
  \hudsetsection{0}{APPENDIX / Q\&A BACKUP}%
}

\def\hud@slidetag{}
\def\hud@tagcolor{HudTeal}
\newcommand{\hudslidetag}[2][HudTeal]{%
  \gdef\hud@tagcolor{#1}%
  \gdef\hud@slidetag{#2}%
}

% Zero-padded frame index helper (idempotent across passes)
\newcommand{\hud@framenum}{%
  \ifhudappendix
    Q\the\numexpr\value{framenumber}-\hud@appoffset\relax
  \else
    \ifnum\value{framenumber}<10 0\fi\insertframenumber
  \fi
}

% ----------------------------------------------------------------------
% 5. Background Canvas Template (Unified Dark HUD Chrome)
% ----------------------------------------------------------------------
\setbeamertemplate{background canvas}{%
  \begin{tikzpicture}[x=1cm,y=1cm]
    \useasboundingbox (0,0) rectangle (16,9);
    % Base canvas
    \fill[HudBg] (0,0) rectangle (16,9);

    % Optional coordinate grid for algorithm slides (02, 04, 05)
    \ifhudgrid
      \draw[HudBorder!14!HudBg, line width=0.3pt, step=0.8cm] (0.64,0.88) grid (15.36,7.92);
    \fi

    % HUD Corner Brackets (inset 0.28cm, arm 0.44cm)
    \draw[HudBorder!65, line width=0.9pt] (0.28,8.28) -- (0.28,8.72) -- (0.72,8.72);
    \draw[HudBorder!65, line width=0.9pt] (15.28,8.72) -- (15.72,8.72) -- (15.72,8.28);
    \draw[HudBorder!65, line width=0.9pt] (0.28,0.72) -- (0.28,0.28) -- (0.72,0.28);
    \draw[HudBorder!65, line width=0.9pt] (15.28,0.28) -- (15.72,0.28) -- (15.72,0.72);
    \fill[HudLavender!80] (0.28,8.72) circle (0.035) (15.72,8.72) circle (0.035)
                           (0.28,0.28) circle (0.035) (15.72,0.28) circle (0.035);

    % Top Chrome: Eyebrow (left) & HCMUT crest + 4-chip indicator (right)
    \node[anchor=west, inner sep=0pt, font=\ttfamily\fontsize{7.2}{8}\selectfont, text=HudGold]
      at (0.85, 8.54) {\hud@eyebrow};

    % Compact HCMUT crest pill left of chips
    \node[anchor=east, fill=HudPanel, draw=HudBorder!40, rounded corners=3pt,
          inner xsep=4pt, inner ysep=1.2pt] (bkbadge) at (13.68, 8.54) {%
      \includegraphics[height=0.31cm]{images/BK.png}%
      \hspace{3pt}{\ttfamily\fontsize{6.0}{7}\selectfont\color{HudMuted}HCMUT}%
    };

    % 4-chip section progress indicator
    \foreach \i in {1,2,3,4} {%
      \pgfmathsetmacro{\chipx}{13.88 + (\i - 1)*0.33}%
      \ifnum\i=\hud@section
        \fill[HudBorder!40, rounded corners=2pt] (\chipx-0.03, 8.41) rectangle (\chipx+0.25, 8.69);
        \fill[HudLavender, rounded corners=1.5pt] (\chipx, 8.44) rectangle (\chipx+0.22, 8.66);
      \else
        \fill[HudTrack, rounded corners=1.5pt] (\chipx, 8.44) rectangle (\chipx+0.22, 8.66);
      \fi
    }

    % Bottom Chrome: Divider with centered gold diamond + Footer + Slide Index
    \draw[HudBorder!45, line width=0.5pt] (0.85, 0.68) -- (15.15, 0.68);
    \fill[HudGold] (8.00, 0.74) -- (8.07, 0.68) -- (8.00, 0.62) -- (7.93, 0.68) -- cycle;

    \node[anchor=west, inner sep=0pt, font=\ttfamily\fontsize{6.5}{7.5}\selectfont, text=HudMuted]
      at (0.85, 0.42) {WIZARD'S CHESS \ / \ INTRO AI (CO3061) \ $\cdot$ \ GROUP 7 \ CC01};

    \node[anchor=east, inner sep=0pt, font=\ttfamily\bfseries\fontsize{8}{9}\selectfont, text=HudLavender]
      at (15.15, 0.42) {\hud@framenum};
  \end{tikzpicture}%
}

% ----------------------------------------------------------------------
% 6. Frametitle Template
% ----------------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \vspace*{0.62cm}%
  \noindent\begin{minipage}[t]{\textwidth}%
    \ifx\hud@slidetag\@empty
      {\raggedright\huddisplay\fontsize{15.2}{18}\selectfont\color{HudIvory}\insertframetitle\par}%
    \else
      \begin{minipage}[t]{0.72\textwidth}%
        {\raggedright\huddisplay\fontsize{15.2}{18}\selectfont\color{HudIvory}\insertframetitle\par}%
      \end{minipage}%
      \hfill%
      \begin{minipage}[t]{0.27\textwidth}%
        \raggedleft
        \raisebox{-0.55ex}{\hudtag[\hud@tagcolor]{\hud@slidetag}}%
      \end{minipage}%
    \fi
    \ifx\insertframesubtitle\@empty\else
      \par\vspace{1.5pt}%
      {\raggedright\fontsize{8.2}{10}\selectfont\color{HudMuted}\insertframesubtitle\par}%
    \fi
  \end{minipage}%
  \gdef\hud@slidetag{}%
  \vspace*{-0.14cm}%
}

% ----------------------------------------------------------------------
% 7. Reusable Vector Icons & HUD Components
% ----------------------------------------------------------------------
\newcommand{\hudcheck}{%
  \raisebox{-0.1ex}{\tikz[x=1mm,y=1mm]{%
    \draw[HudTeal, line width=1.1pt, line cap=round, line join=round] (0,1.2) -- (1.0,0.2) -- (2.6,2.2);%
  }}%
}
\newcommand{\hudcross}{%
  \raisebox{-0.1ex}{\tikz[x=1mm,y=1mm]{%
    \draw[HudCrimson, line width=1.1pt, line cap=round] (0,0) -- (2.2,2.2) (0,2.2) -- (2.2,0);%
  }}%
}
\newcommand{\huddiamond}[1][HudGold]{%
  \raisebox{0.15ex}{\tikz[x=1mm,y=1mm]{%
    \fill[#1] (1.2,0) -- (2.4,1.2) -- (1.2,2.4) -- (0,1.2) -- cycle;%
  }}%
}
\newcommand{\hudarrow}[1][HudTeal]{%
  \raisebox{0.25ex}{\tikz[x=1mm,y=1mm]{%
    \draw[#1, line width=1pt, -{Stealth[length=1.8mm,width=1.4mm]}] (0,0) -- (5.5,0);%
  }}%
}

% Status tag badge
\newcommand{\hudtag}[2][HudTeal]{%
  \tikz[baseline=(n.base)]{%
    \node[fill=HudTrack, draw=#1!65, line width=0.6pt, rounded corners=2.5pt,
          inner xsep=5pt, inner ysep=2.2pt, text=#1,
          font=\ttfamily\fontsize{6.6}{7.5}\selectfont\bfseries] (n) {#2};%
  }%
}

% Diamond divider
\newcommand{\huddivider}[1]{%
  \begin{tikzpicture}[x=1cm,y=1cm]
    \pgfmathsetmacro{\halfw}{#1/2}
    \draw[HudBorder!50, line width=0.6pt] (0,0) -- (\halfw-0.25,0);
    \draw[HudBorder!50, line width=0.6pt] (\halfw+0.25,0) -- (#1,0);
    \fill[HudLavender] (\halfw,0.10) -- (\halfw+0.10,0) -- (\halfw,-0.10) -- (\halfw-0.10,0) -- cycle;
    \fill[HudGold] (\halfw,0) circle (0.035);
  \end{tikzpicture}%
}

% Frosted glassmorphism card
\newcommand{\hudcard}[3][]{%
  \begin{tikzpicture}
    \node[fill=HudPanel, draw=HudBorder!40, line width=0.65pt, rounded corners=5pt,
          inner sep=8pt, text width=#2, align=left, text=HudIvory, #1] (c) {#3};
    \draw[HudLavender!80, line width=0.95pt, rounded corners=5pt]
      ($(c.north west)+(0,-0.28)$) |- ($(c.north west)+(0.28,0)$);
    \draw[HudLavender!80, line width=0.95pt, rounded corners=5pt]
      ($(c.south east)+(0,0.28)$) |- ($(c.south east)+(-0.28,0)$);
  \end{tikzpicture}%
}

% Frosted card with crisp colored left accent bar
\newcommand{\hudcardaccent}[4][8pt]{%
  \begin{tikzpicture}
    \node[fill=HudPanel, draw=HudBorder!35, line width=0.6pt, rounded corners=5pt,
          inner sep=#1, text width=#3, align=left, text=HudIvory] (c) {#4};
    \draw[#2, line width=2.2pt, line cap=round]
      ($(c.north west)+(0.03,-0.16)$) -- ($(c.south west)+(0.03,0.16)$);
  \end{tikzpicture}%
}

% Oversized hero metric with simulated soft glow (fast single-pass XeLaTeX)
\newcommand{\hudhero}[3][HudLavender]{%
  \begin{tikzpicture}[baseline=(fg.base)]
    \node[inner sep=0pt, text=HudBorder!45, opacity=0.35,
          font=\huddisplay\fontsize{#2}{#2}\selectfont] at (0.04,-0.03) {#3};
    \node[inner sep=0pt, text=#1!55, opacity=0.35,
          font=\huddisplay\fontsize{#2}{#2}\selectfont] at (-0.03,0.03) {#3};
    \node[inner sep=0pt, text=#1,
          font=\huddisplay\fontsize{#2}{#2}\selectfont] (fg) at (0,0) {#3};
  \end{tikzpicture}%
}

% Dark-mode horizontal bar row: {label}{labelW_cm}{barW_cm}{fraction}{valueText}{color}
\newcommand{\hudbar}[6]{%
  \begin{tikzpicture}[x=1cm,y=1cm]
    \node[anchor=west, inner sep=0pt, text width=#2cm, align=left,
          font=\fontsize{8.3}{9.5}\selectfont\bfseries, text=HudIvory] at (0,0) {#1};
    \pgfmathsetmacro{\bx}{#2 + 0.15}
    \pgfmathsetmacro{\fillw}{max(0.08, #3 * #4)}
    \fill[HudTrack, rounded corners=2.2pt] (\bx,-0.11) rectangle (\bx+#3,0.11);
    \fill[#6, rounded corners=2.2pt] (\bx,-0.11) rectangle (\bx+\fillw,0.11);
    \fill[#6!50!white, rounded corners=1pt] (\bx+\fillw-0.06,-0.11) rectangle (\bx+\fillw,0.11);
    \node[anchor=west, inner sep=0pt, font=\ttfamily\fontsize{8}{9}\selectfont\bfseries, text=#6]
      at (\bx+#3+0.18, 0) {#5};
  \end{tikzpicture}%
}

% Slide 09 synchronized blunder pip-meter + tournament score row:
% {label}{blunders_int}{blunder_text}{score_frac}{score_text}{bar_color}
\newcommand{\hudpiprow}[6]{%
  \begin{tikzpicture}[x=1cm,y=1cm]
    \node[anchor=west, inner sep=0pt, text width=2.2cm,
          font=\fontsize{8.3}{9.5}\selectfont\bfseries, text=HudIvory] at (0,0) {#1};
    % 18 discrete pips starting at x=2.35
    \foreach \p in {1,...,18} {%
      \pgfmathsetmacro{\px}{2.35 + (\p - 1)*0.22}%
      \ifnum\p>#2
        \fill[HudTrack, rounded corners=0.8pt] (\px,-0.12) rectangle (\px+0.15,0.12);
      \else
        \fill[HudGold, rounded corners=0.8pt] (\px,-0.12) rectangle (\px+0.15,0.12);
      \fi
    }
    \node[anchor=west, inner sep=0pt, font=\ttfamily\fontsize{8}{9}\selectfont\bfseries,
          text=\ifnum#2>0 HudGold\else HudTeal\fi] at (6.42,0) {#3};
    % Score bar starting at x=7.75, width 4.2cm
    \pgfmathsetmacro{\sbx}{7.75}
    \pgfmathsetmacro{\sw}{4.20}
    \pgfmathsetmacro{\sfw}{max(0.10, \sw * #4)}
    \fill[HudTrack, rounded corners=2.2pt] (\sbx,-0.11) rectangle (\sbx+\sw,0.11);
    \fill[#6, rounded corners=2.2pt] (\sbx,-0.11) rectangle (\sbx+\sfw,0.11);
    \node[anchor=west, inner sep=0pt, font=\ttfamily\fontsize{8}{9}\selectfont\bfseries, text=#6]
      at (\sbx+\sw+0.18, 0) {#5};
  \end{tikzpicture}%
}

% Slide 11 paired limitation -> next step card row
\newcommand{\hudlimpair}[3]{% {y}{lim}{next}
  \node[fill=HudPanel, draw=HudBorder!35, rounded corners=4pt, inner xsep=8pt, inner ysep=4.5pt,
        text width=6.05cm, minimum height=0.80cm, anchor=west, text=HudIvory] (L) at (0,#1) {%
    {\ttfamily\fontsize{6.2}{7.2}\selectfont\bfseries\color{HudGold}LIMITATION}\\[1pt]
    {\fontsize{8.1}{10}\selectfont\color{HudIvory}#2}%
  };
  \draw[HudGold, line width=2pt, line cap=round] ($(L.north west)+(0.03,-0.12)$) -- ($(L.south west)+(0.03,0.12)$);
  \draw[HudTeal, line width=1pt, -{Stealth[length=2mm]}] (6.68,#1) -- (7.48,#1);
  \node[fill=HudPanel, draw=HudBorder!35, rounded corners=4pt, inner xsep=8pt, inner ysep=4.5pt,
        text width=6.15cm, minimum height=0.80cm, anchor=west, text=HudIvory] (R) at (7.58,#1) {%
    {\ttfamily\fontsize{6.2}{7.2}\selectfont\bfseries\color{HudTeal}NEXT STEP}\\[1pt]
    {\fontsize{8.1}{10}\selectfont\color{HudIvory}#3}%
  };
  \draw[HudTeal, line width=2pt, line cap=round] ($(R.north west)+(0.03,-0.12)$) -- ($(R.south west)+(0.03,0.12)$);
}
